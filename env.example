# ─────────────────────────────────────────────
# SwiftCredit Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# MongoDB (use MongoDB Atlas free tier for Render deployment)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/swiftcredit?retryWrites=true&w=majority

# Lipana M-Pesa API
LIPANA_SECRET_KEY=lip_sk_live_YOUR_LIPANA_SECRET_KEY_HERE
LIPANA_BASE_URL=https://api.lipana.dev

# App URL (your Render URL, e.g. https://swiftcredit.onrender.com)
APP_URL=https://your-app-name.onrender.com

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SwiftCredit@Admin2024!
ADMIN_JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_64_chars

# Session Secret
SESSION_SECRET=replace_with_another_long_random_secret_for_sessions

# Processing Fee (KES)
PROCESSING_FEE=500
